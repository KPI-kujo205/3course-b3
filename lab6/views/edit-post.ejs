<h1 class="mb-4">Edit Note</h1>

<form action="/edit/<%= post._id %>" method="POST">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="title" value="<%= post.title %>" required>
    </div>
    <div class="mb-3">
        <label for="author" class="form-label">Author</label>
        <input type="text" class="form-control" id="author" name="author" value="<%= post.author %>" required>
    </div>
    <div class="mb-3">
        <label for="text" class="form-label">Text</label>
        <textarea class="form-control" id="text" name="text" rows="5" required><%= post.text %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form> 